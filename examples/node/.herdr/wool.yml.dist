# yaml-language-server: $schema=https://raw.githubusercontent.com/svenluijten/wool/main/schema/wool.schema.json
version: 1

setup:
  - name: Install dependencies
    run: npm ci

tabs:
  - title: Agent
    panes:
      - agent: default
  - title: Shell
    panes:
      - {}
  - title: Dev
    panes:
      - command: npm run dev
        setup: true
