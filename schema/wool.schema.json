{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/svenluijten/wool/main/schema/wool.schema.json",
  "title": "wool config (.herdr/wool.yml(.dist)): setup steps and the space layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "env": {
      "type": "object",
      "description": "Environment variables (NAME: value) for every setup step, pane and background command, under their own env.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "setup": {
      "type": "array",
      "description": "Setup steps, run in order in the new worktree; the first failure stops setup. [] is valid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Label shown while it runs."
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "description": "Run as /bin/sh -c <run> in the new worktree."
          },
          "env": {
            "type": "object",
            "description": "Environment variables (NAME: value), over the top-level env.",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "setupIn": {
      "type": "string",
      "enum": [
        "tab",
        "background"
      ],
      "default": "tab",
      "description": "Where setup runs: in a tab you can watch, or in the background with its output in setup.log (a tab opens only if it fails). background can't be combined with a setup: true pane."
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "panes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Runs in your interactive shell; the shell stays when it exits."
                },
                "agent": {
                  "type": "string",
                  "minLength": 1,
                  "description": "wool extension value 'default': your most-picked installed agent. Or an agent key (claude, codex, ...)."
                },
                "prompt": {
                  "type": "string",
                  "description": "The agent's first message. Needs agent."
                },
                "env": {
                  "type": "object",
                  "description": "Environment variables (NAME: value).",
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "split": {
                  "enum": [
                    "right",
                    "down",
                    "vertical",
                    "horizontal"
                  ],
                  "description": "How this pane splits from the previous one (vertical = right, horizontal = down). Not on a tab's first pane. Default right."
                },
                "setup": {
                  "type": "boolean",
                  "description": "This pane shows setup's output, then runs its command after setup succeeds. At most one per file; not on an agent pane."
                },
                "waitForSetup": {
                  "type": "boolean",
                  "description": "wool extension: the command waits for setup to succeed and doesn't run if it fails. Needs command."
                },
                "focus": {
                  "type": "boolean",
                  "description": "wool extension: this pane has the keyboard when the space opens. At most one."
                }
              },
              "allOf": [
                {
                  "not": {
                    "required": [
                      "command",
                      "agent"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "prompt"
                    ]
                  },
                  "then": {
                    "required": [
                      "agent"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "waitForSetup"
                    ],
                    "properties": {
                      "waitForSetup": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "command"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "setup"
                    ],
                    "properties": {
                      "setup": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "agent"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "description": "The layout for a space that arrives as a plain shell. Leave it out for setup only."
    },
    "background": {
      "type": "array",
      "description": "wool extension: commands with no pane. Needs tabs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "description": "Environment variables (NAME: value).",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "waitForSetup": {
            "type": "boolean"
          }
        }
      }
    },
    "teardown": {
      "type": "array",
      "description": "Teardown steps, run in order in the main checkout after the worktree is removed (its folder is gone by then); the first failure stops teardown.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Label shown while it runs."
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "description": "Run as /bin/sh -c <run> in the main checkout."
          },
          "env": {
            "type": "object",
            "description": "Environment variables (NAME: value), over the top-level env.",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "setup"
      ]
    },
    {
      "required": [
        "tabs"
      ]
    }
  ],
  "dependencies": {
    "background": [
      "tabs"
    ]
  }
}
